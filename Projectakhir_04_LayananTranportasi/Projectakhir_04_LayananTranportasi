        cat_choice = input("Pilih kategori (angka): ")
        if not cat_choice.isdigit() or not (1 <= int(cat_choice) <= len(menu_kategori)):
            print("Input salah!")
            continue
        cat_index = int(cat_choice) - 1
        cat_name = list(menu_kategori.keys())[cat_index]
        tampilkan_detail_kategori(cat_name)

        while True:
            pilih = input("Pilih nomor makanan (atau 'b' untuk kembali kategori): ")
            if pilih.lower() == 'b':
                break
            if not pilih.isdigit() or int(pilih) not in menu_kategori[cat_name]:
                print("Input salah!")
                continue
            no = int(pilih)
            nama, harga = menu_kategori[cat_name][no]
            pesanan.append((cat_name, nama, harga))
            total += harga
            print(f"Ditambahkan: {nama} - Rp {harga}")

            t = input("Tambah lagi di kategori ini? (y/n): ").lower()
            if t == "n":
                break

        lagi_cat = input("Pilih kategori lain? (y/n): ").lower()
        if lagi_cat == "n":
            break

    if not pesanan:
        print("Tidak ada pesanan. Batal.")
        return

    print("\n=========== RINCIAN PESANAN ===========")
    for cat, nama, h in pesanan:
        print(f"[{cat}] {nama:<20} Rp {h}")
    print("---------------------------------------")
    print(f"TOTAL BELANJA: Rp {total}")
    print("---------------------------------------")

    berhasil = pembayaran(total)
    if not berhasil:
        return

    txid = next_tx()
    waktu = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    transaksi = {
        "id": txid,
        "jenis": "GoFood",
        "makanan": pesanan,
        "total": total,
        "waktu": waktu
    }
    riwayat.append(transaksi)
    print(f"Transaksi ID: {txid} tercatat. Simpan ID untuk komplain jika perlu.")

    cetak_struk_gofood(transaksi)


