def search_driver_nearby():
    jumlah_opsi = random.choice([2,3,6,7])
    eligible = [d for d in drivers if d["status"] == "ON"]
    if len(eligible) < jumlah_opsi:
        pool = drivers[:]
    else:
        pool = eligible 

    pilihan_driver = random.sample(pool, min(jumlah_opsi, len(pool)))
    jarak_options = [2000, 3000, 6000, 7000, 250, 500, 1200]
    hasil = []
    for d in pilihan_driver:
        jarak_m = random.choice(jarak_options)
        hasil.append((d, jarak_m))

    print("\n--- Driver Terdekat Sekitar Anda ---")
    print(f"{'No':<3} {'Nama':<12} {'Jarak':<12} {'Status':<7} {'Rating'}")
    print("-" * 40)
    for i, (d, jarak_m) in enumerate(hasil, 1):
        km = jarak_m / 1000
        print(f"{i:<3} {d['nama']:<12} {jarak_m:>5} m ({km:.1f} km)  {d['status']:<6} {rata_rating(d):.2f}")
    print("-" * 40)

    while True:
        pilih = input(f"Pilih driver (1-{len(hasil)}) atau 'b' batal: ")
        if pilih.lower() == 'b':
            return None
        if not pilih.isdigit():
            print("Input harus angka atau 'b'!")
            continue
        idx = int(pilih)
        if 1 <= idx <= len(hasil):
            driver_obj = hasil[idx-1][0]
            driver_obj["status"] = "SIBUK"
            print(f"Driver {driver_obj['nama']} dipilih (status berubah jadi SIBUK).")
            return driver_obj["nama"]
        else:
            print("Pilihan di luar jangkauan!")

