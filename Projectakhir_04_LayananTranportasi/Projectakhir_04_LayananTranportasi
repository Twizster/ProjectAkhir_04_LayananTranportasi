            return d["nama"]
        else:
            print("ID tidak valid!")


def komplain_rating(nama_driver):
    global riwayat
    print("\n======================================")
    print("         RATING & KOMPLAIN DRIVER     ")
    print("======================================")

    while True:
        rating = input("Masukkan rating (1-10): ")
        if rating.isdigit():
            rating_int = int(rating)
            if 1 <= rating_int <= 10:
                break
        print("Rating harus angka antara 1 sampai 10!")

    komplain = input("Masukkan komplain (opsional, tekan Enter jika tidak ada): ")

