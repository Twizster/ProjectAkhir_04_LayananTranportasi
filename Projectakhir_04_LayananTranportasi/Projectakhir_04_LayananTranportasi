def hapus_riwayat_by_id():
    global riwayat
    if not riwayat:
        print("Riwayat kosong, tidak ada yang dihapus.")
        return
    id_raw = input("Masukkan ID riwayat yang ingin dihapus: ")
    if not id_raw.isdigit():
        print("ID harus angka!")
        return
    idn = int(id_raw)
    for i, r in enumerate(riwayat):
        if r.get('id') == idn:
            konfirm = input(f"Yakin hapus riwayat ID {idn}? (y/n): ").lower()
            if konfirm == 'y':
                riwayat.pop(i)
                print(f"Riwayat ID {idn} berhasil dihapus.")
            else:
                print("Penghapusan dibatalkan.")
            return
    print("ID tidak ditemukan di riwayat.")

