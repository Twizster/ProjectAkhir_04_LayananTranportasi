def proses_bayar_gopay(total):
    global gopay, koin
    percobaan = 0
    while percobaan < 3:
        print("\n-----------------------------------------")
        print(f"Saldo GoPay saat ini: Rp {gopay}")
        used_coins = 0
        if koin > 0:
            while True:
                pakai_koin = input(f"Gunakan koin afinitas? (y/n) [1 koin = Rp {KOIN_VALUE}]: ").lower()
                if pakai_koin in ("y", "n"):
                    break
                print("Input harus 'y' atau 'n'!")
            if pakai_koin == "y":
                while True:
                    use = input(f"Masukkan jumlah koin yang ingin dipakai (max {koin}): ")
                    if not use.isdigit():
                        print("Harus angka!")
                        continue
                    use = int(use)
                    if 0 <= use <= koin:
                        diskon_koin = use * KOIN_VALUE
                        total_after_koin = max(0, total - diskon_koin)
                        print(f"Diskon koin: Rp {diskon_koin}. Total setelah koin: Rp {total_after_koin}")
                        confirm = input("Lanjut pakai koin untuk pembayaran? (y/n): ").lower()
                        if confirm == "y":
                            used_coins = use
                            total = total_after_koin
                            break
                        else:
                            used_coins = 0
                            break
                    else:
                        print("Jumlah koin tidak valid!")
        print("-----------------------------------------")
        bayar = input("Masukkan nominal pembayaran GoPay: ")
        if not bayar.isdigit():
            print("Nominal harus angka!")
            percobaan += 1
            continue
        bayar = int(bayar)

        if bayar < total:
            print(f"Nominal kurang! Percobaan {percobaan+1}/3")
            percobaan += 1
            continue

        if bayar > gopay:
            print("Nominal melebihi saldo GoPay! Masukkan nominal <= saldo!")
            percobaan += 1
            continue

        kembalian = bayar - total
        gopay -= bayar
        if kembalian > 0:
            gopay += kembalian
            print(f"Kembalian Rp {kembalian} dikembalikan ke GoPay.")
        if used_coins > 0:
            koin -= used_coins
            print(f"{used_coins} koin berhasil dipakai. Sisa koin: {koin}")
        print(f"Pembayaran GoPay berhasil! Sisa GoPay: Rp {gopay}")
        return True
    print("Gagal pembayaran GoPay setelah 3 kali percobaan.")
    return False

def proses_bayar_tunai(total):
    percobaan = 0
    while percobaan < 3:
        uang = input("Masukkan uang tunai yang diberikan: ")
        if not uang.isdigit():
            print("Nominal harus angka!")
            percobaan += 1
            continue
        uang = int(uang)
        if uang < total:
            print(f"Uang kurang Rp {total - uang}. Percobaan {percobaan+1}/3")
            percobaan += 1
            continue
        kembalian = uang - total
        print("\n==== STRUK PEMBAYARAN TUNAI ====")
        print(f"Total Belanja : Rp {total}")
        print(f"Uang Dibayar  : Rp {uang}")
        print(f"Kembalian     : Rp {kembalian}")
        print("================================")
        return True
    print("Gagal pembayaran tunai setelah 3 percobaan.")
    return False

