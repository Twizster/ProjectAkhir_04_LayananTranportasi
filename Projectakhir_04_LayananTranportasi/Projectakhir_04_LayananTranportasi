    else:
        sukses = proses_bayar_tunai(total)
        if not sukses:
            print("Pembayaran tunai gagal. Transaksi dibatalkan.")
            return False
        return True



def hitung_tarif(jarak_km):
    return int(jarak_km * 3000)

def fitur_goride():
    global riwayat, koin
    print("\n======================================")
    print("               GO-RIDE                ")
    print("======================================")

    print("Pilih metode mendapatkan driver:")
    print("1. Otomatis pilih driver")
    print("2. Cari driver terdekat")
    print("3. Pilih manual dari daftar driver (masukkan ID)")
    while True:
        cara = input("Pilih (1-3): ")
        if cara not in ("1","2","3"):
            print("Input salah!")
            continue
        break

    if cara == "1":
        nama_driver = pilih_driver_auto()
    elif cara == "2":
        nama_driver = search_driver_nearby()
        if nama_driver is None:
            print("Pencarian dibatalkan. Kembali ke menu.")
            return
    else:
        nama_driver = pilih_driver_manual_by_id()
        if nama_driver is None:
            print("Pilihan manual dibatalkan. Kembali ke menu.")
            return

    print("--------------------------------------")
    while True:
        jarak_raw = input("Masukkan jarak (km) untuk perhitungan tarif (contoh: 2.5): ")
        try:
            jarak = float(jarak_raw)
            if jarak <= 0:
                print("Jarak harus > 0!")
                continue
            break
        except:
            print("Input harus angka! (contoh: 2.5)")

    biaya = hitung_tarif(jarak)
    print("--------------------------------------")
    print(f"Biaya awal: Rp {biaya}")

    while True:
        pakai = input("Pakai voucher? (y/n): ").lower()
        if pakai in ("y","n"):
            break
        print("Input harus 'y' atau 'n'!")
    if pakai == "y":
        kode = input("Masukkan kode voucher: ").upper()
        if kode in vouchers:
            diskon = int(biaya * vouchers[kode])
            biaya -= diskon
            print(f"Voucher diterima! Diskon Rp {diskon}")
        else:
            print("Voucher tidak valid.")
    print("--------------------------------------")
    print(f"Total bayar : Rp {biaya}")
    print("--------------------------------------")

    berhasil = pembayaran(biaya)
    if not berhasil:
        set_driver_status(nama_driver, "ON")
        return

    txid = next_tx()
    waktu = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    transaksi = {
        "id": txid,
        "jenis": "GoRide",
        "driver": nama_driver,
        "jarak": jarak,
        "total": biaya,
        "waktu": waktu
    }
    riwayat.append(transaksi)
    print(f"Transaksi ID: {txid} tercatat. Simpan ID untuk komplain jika perlu.")

    beri_koin_jarak(jarak)

    for d in drivers:
        if d["nama"].lower() == nama_driver.lower():
            d["completed"] += 1
            set_driver_status(nama_driver, "ON")
            break


    cetak_struk_goride(transaksi)

    while True:
        t = input("Ingin beri rating/komplain sekarang? (y/n): ").lower()
        if t in ("y","n"):
            break
        print("Input harus 'y' atau 'n'!")
    if t == "y":
        komplain_rating(nama_driver)


