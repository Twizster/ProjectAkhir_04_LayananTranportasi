def lihat_koin_menu():
    global koin, gopay
    while True:
        print("\n=========================================")
        print("             KOIN AFINITAS               ")
        print("=========================================")
        print(f"Jumlah koin: {koin}")
        print(f"Konversi: 1 koin = Rp {KOIN_VALUE}")
        print("-----------------------------------------")
        print("1. Tukar koin ke GoPay")
        print("2. Kembali")
        pilihan = input("Pilih (1-2): ")
        if pilihan == "1":
            if koin <= 0:
                print("Tidak ada koin untuk ditukar.")
                continue
            while True:
                use_raw = input(f"Masukkan jumlah koin yang ingin ditukar (max {koin}): ")
                if not use_raw.isdigit():
                    print("Harus angka!")
                    continue
                use = int(use_raw)
                if use <= 0 or use > koin:
                    print("Jumlah koin tidak valid!")
                    continue
                nilai = use * KOIN_VALUE
                if use >= 100:
                    potongan = int(nilai * 0.01)
                    nilai_setelah = nilai - potongan
                    print(f"Karena menukar >=100 koin, dikenakan potongan 1% = Rp {potongan}.")
                else:
                    nilai_setelah = nilai
                konfirm = input(f"Tukar {use} koin -> Rp {nilai_setelah}? (y/n): ").lower()
                if konfirm == 'y':
                    koin -= use
                    gopay += nilai_setelah
                    print(f"Tukar berhasil! Sisa koin: {koin}. Saldo GoPay: Rp {gopay}")
                    break
                else:
                    print("Tukar dibatalkan.")
                    break
        elif pilihan == "2":
            return
        else:
            print("Input salah!")



