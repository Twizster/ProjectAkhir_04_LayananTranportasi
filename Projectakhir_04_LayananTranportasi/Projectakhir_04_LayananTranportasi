def build_flat_menu():
    flat = {}
    counter = 1
    for cat, items in menu_kategori.items():
        for id_in_cat, (name, price) in items.items():
            flat[counter] = {"kategori": cat, "id_kategori": id_in_cat, "nama": name, "harga": price}
            counter += 1
    return flat

flat_menu = build_flat_menu()

def promo_hari_ini():
    promo_item_key = random.choice(list(flat_menu.keys()))
    promo_item = flat_menu[promo_item_key]
    disc_percent = random.randint(10, 50) 
    disc_amount = int(promo_item["harga"] * disc_percent / 100)
    promo_price = promo_item["harga"] - disc_amount
    print("\n=========================================")
    print("            PROMO HARI INI              ")
    print("=========================================")
    print(f"{promo_item['nama']} ({promo_item['kategori']})")
