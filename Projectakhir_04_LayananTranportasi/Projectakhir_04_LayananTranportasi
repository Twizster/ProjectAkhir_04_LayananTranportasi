    print(f"Diskon       : {disc_percent}%  -> Rp {disc_amount}")
    print(f"Harga promo  : Rp {promo_price}")
    print("=========================================")
    return promo_item_key, promo_price

def rata_rating(d):
    if d["rating_count"] == 0:
        return 0.0
    return d["rating_total"] / d["rating_count"]

